# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — deployed frontend origin (required in production)
CLIENT_ORIGIN=http://localhost:3000

# File uploads — local disk directory (required in production).
# WARNING: Render/Railway ephemeral disks wipe this on redeploy — see scripts/DEPLOY.md
UPLOAD_DIR=uploads

# NST Email Configuration
NST_EMAIL_DOMAIN=my.nst.edu.ph

# File Uploads (optional overrides)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=120

# Backblaze B2 (S3-compatible) — private bucket, all reads via presigned URLs (required in production)
B2_BUCKET_NAME=novaschola-media-2026
B2_BUCKET_ID=fcaa542db76cdf00a30b0015
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PRESIGN_EXPIRY_SECONDS=3600