# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Test database (isolated from production, used only when NODE_ENV=test).
# Configure in gitignored server/.env.test — see server/.env.test.example.
# The test guard refuses to run without it and never falls back to DATABASE_URL.
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/novaschola_test?sslmode=disable

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# CORS — deployed frontend origin (required in production)
CLIENT_ORIGIN=http://localhost:3000

# NST Email Configuration — institutional domains per role
NST_ADMIN_EMAIL_DOMAIN=nst.edu.ph
NST_TEACHER_EMAIL_DOMAIN=tr.nst.edu.ph
NST_STUDENT_EMAIL_DOMAIN=my.nst.edu.ph
# Legacy single-domain alias for the student domain (optional when the
# role-specific variables above are set)
NST_EMAIL_DOMAIN=my.nst.edu.ph

# Image uploads use B2; JPEG/PNG/WebP only, fixed maximum 10 MiB.

# Backblaze B2 (S3-compatible) — private bucket, all reads via presigned URLs (required in production)
B2_BUCKET_NAME=novaschola-media-2026
B2_BUCKET_ID=fcaa542db76cdf00a30b0015
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PRESIGN_EXPIRY_SECONDS=3600
# Opt in only after approving the target database and completing publication/email rollout.
# Disabled by default so a local server cannot silently publish live scheduled data.
ANNOUNCEMENT_SCHEDULER_ENABLED=false

# Backend only. disabled sends nothing; mock is for local tests; test redirects;
# live delivers to resolved active NST users. Production defaults to disabled.
EMAIL_MODE=disabled
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
# A verified personal sender is allowed (including Gmail); never the logged-in user.
# Brevo may rewrite free-mail sender addresses for authentication; verify inbox From.
EMAIL_SENDER_NAME=Nova Schola Hub
# Required ISO UTC cutoff for live/test delivery; announcement created_at must
# be at/after this value, including drafts. Use a fresh cutoff at first rollout.
EMAIL_ENABLED_AT=
# test mode sends only to this reviewed mailbox (never resolved real recipients).
EMAIL_TEST_RECIPIENT=
