{
  "name": "novaschola-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova Schola Hub API server",
  "engines": {
    "node": "22.x"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/shared/db/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node src/shared/db/migrate.js",
    "seed:production": "node scripts/seed-production.js",
    "test": "cross-env NODE_ENV=test node --import ./tests/safe-network.js --experimental-test-module-mocks --test --test-concurrency=1 tests/requireRole.test.js tests/utils.test.js tests/sectionInput.test.js tests/batch1/*.test.js tests/batch2/*.test.js tests/batch3/*.test.js",
    "test:batch2": "node --experimental-test-module-mocks --test tests/batch2/email.test.js tests/batch2/integration.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.616.0",
    "@aws-sdk/s3-request-presigner": "^3.616.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.4"
  }
}
